# Copy this file to `.env` and fill in your key. Never commit the real `.env`.

# Required: get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_key_here

# Optional: gate the app with a single password (recommended when deployed).
# Leave empty for open local use.
APP_PASSWORD=

# Optional model overrides (defaults shown)
# GEMINI_CHAT_MODEL=gemini-flash-latest
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# GEMINI_TEMPERATURE=0.1

# Optional OCR settings for scanned PDFs
# OCR_ENABLED=true
# OCR_DPI=150
# OCR_MAX_PAGES=300

# Optional retrieval / summarization tuning
# RETRIEVAL_K=5
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=200
# SUMMARY_MAP_CHARS=12000
# SUMMARY_THROTTLE_SECONDS=0

# Where uploaded PDFs + the index are stored (mount as a volume when deployed)
# DATA_DIR=data

TOKENIZERS_PARALLELISM=false
