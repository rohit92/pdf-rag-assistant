# Streamlit Community Cloud secrets.
# Copy to `.streamlit/secrets.toml` locally, or paste into the app's
# "Advanced settings → Secrets" box when deploying. NEVER commit the real file.

GOOGLE_API_KEY = "your_key_here"

# Optional: set a password to gate the deployed app (protects your API bill).
# APP_PASSWORD = "choose-a-strong-password"

# Optional overrides
# GEMINI_CHAT_MODEL = "gemini-flash-latest"
# GEMINI_EMBEDDING_MODEL = "models/gemini-embedding-001"
